<html>
    <body>
        <h1>Bookstore Inventory Manager</h1>
        <%- include('navigationBar') %>
        <button class="addGenre">Add New Genre</button>
        <form action="/genres" method="post" class="addGenreForm" 
            style="visibility: hidden; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); padding: 20%; background-color: white; border: solid 1px black; border-radius: 10px;">
            <label for="genreName">Name:</label>
            <input id="genreName" name="genreName" type="text">
            <button type="submit" class="addGenreFormSubmit">Add</button>
            <button type="button" class="addGenreFormClose" style="position: absolute; top: 2%; right: 2%;">x</button>
        </form>

        <table>
            <% genres.forEach((genre) => { %>
                <% if (genre !== "None") {%>
                <tr>
                    <td style="border: solid 1px black; padding: 10px;"><%= genre %></td>
                    <td>    
                        <button class="edit-Btn" data-genre="<%- genre %>" style="background-color: #2062e5; color: white; border-radius: 5px;">Edit</button>
                    </td>
                    <td>
                        <button class="delete-Btn" data-genre="<%- genre %>" style="background-color: red; border-radius: 5px;">Delete</button>
                    </td>
                </tr>
                <% } %>
            <% }); %>
        </table>

        <form action="/genres" method="post" class="editGenreForm" 
            style="visibility: hidden; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); padding: 20%; background-color: white; border: solid 1px black; border-radius: 10px;">
            <label for="new-genre-name">New Name:</label>
            <input id="new-genre-name" name="newGenreName" type="text">
            <input id="old-genre-name" name="oldGenreName" style="visibility: hidden;">
            <button type="submit" class="editGenreFormSubmit">Update</button>
            <button type="button" class="editGenreFormClose" style="position: absolute; top: 2%; right: 2%;">x</button>
        </form>

        <form action="/genres" method="post" class="deleteGenreForm" 
            style="visibility: hidden; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); padding: 20% 5%; background-color: white; border: solid 1px black; border-radius: 10px;">
            <label for="delete-warning">Are you sure you would like to delete this genre? </label>
            <input id="delete-warning" name="deleteInput" style="visibility: hidden;">
            <button type="submit" class="deleteGenreFormSubmit">Delete</button>
            <button type="button" class="deleteGenreFormClose" style="position: absolute; top: 2%; right: 2%;">x</button>
        </form>

        

        <script>
            const addGenre = document.querySelector(".addGenre");
            const addGenreForm = document.querySelector(".addGenreForm");
            const addGenreFormSubmit = document.querySelector(".addGenreFormSubmit");
            const addGenreFormClose = document.querySelector(".addGenreFormClose");
            addGenre.addEventListener("click", () => addGenreForm.style.visibility = "visible")
            addGenreFormClose.addEventListener("click", () => addGenreForm.style.visibility = "hidden")
            addGenreFormSubmit.addEventListener("click", () => addGenreForm.style.visibility = "hidden")

            const editButtons = document.querySelectorAll(".edit-Btn");
            const deleteButtons = document.querySelectorAll(".delete-Btn");
            const editGenreForm = document.querySelector(".editGenreForm");
            const deleteGenreForm = document.querySelector(".deleteGenreForm");
            const editGenreFormClose = document.querySelector(".editGenreFormClose");
            const deleteGenreFormClose = document.querySelector(".deleteGenreFormClose");
            const editGenreFormSubmit = document.querySelector(".editGenreFormSubmit");
            const deleteGenreFormSubmit = document.querySelector(".deleteGenreFormSubmit");
            const editInput = document.querySelector("#old-genre-name")
            const deleteInput = document.querySelector("#delete-warning");

            editButtons.forEach(button => {
                button.addEventListener('click', (event) => {
                const genre = event.target.dataset.genre;
                console.log('Edit clicked for genre:', genre);
                editInput.value = genre;
                editGenreForm.style.visibility = "visible"
                });
            });
            deleteButtons.forEach(button => {
                button.addEventListener('click', (event) => {
                const genre = event.target.dataset.genre;
                console.log('Delete clicked for genre:', genre);
                deleteInput.value = genre;
                deleteGenreForm.style.visibility = "visible"
                });
            });

            editGenreFormClose.addEventListener("click", () => editGenreForm.style.visibility = "hidden")
            editGenreFormSubmit.addEventListener("click", () => editGenreForm.style.visibility = "hidden")

            deleteGenreFormClose.addEventListener("click", () => deleteGenreForm.style.visibility = "hidden")
            deleteGenreFormSubmit.addEventListener("click", () => deleteGenreForm.style.visibility = "hidden")

        </script>
    </body>
</html>
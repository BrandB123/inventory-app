<html>
    <body>
        <h1>Bookstore Inventory Manager</h1>
        <%- include('navigationBar') %>
        <%- include('genreSelector') %>

        <button class="addBook" style="margin-left: 30px;">Add New Book</button>
        <form action="/" method="post" class="addBookForm" 
        style="visibility: hidden; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); padding: 20%; background-color: white; border: solid 1px black; border-radius: 10px;">
            <label for="bookName">Title:</label>
            <input id="bookName" name="bookName" type="text">
            <label for="bookGenre">Genre:</label>
            <select name="bookGenre" id="bookGenre" value="--Genre--">
                <option value="--Genre--" disabled selected>--Genre--</option>
                <% genres.forEach((genre) => { %>
                    <option value="<%= genre %>"><%= genre %></option>
                <% }); %>
            </select>
            <label for="bookPrice">Price:</label>
            <input id="bookPrice" name="bookPrice" type="text">
            <label for="bookQuantity">Quantity:</label>
            <input id="bookQuantity" name="bookQuantity" type="text">
            <button type="submit" class="addBookFormSubmit">Add</button>
            <button type="button" class="addBookFormClose" style="position: absolute; top: 2%; right: 2%;">x</button>
        </form>

        <table>
            <tr>
                <th style="border: solid 1px black; padding: 10px;">Title</th>
                <th style="border: solid 1px black; padding: 10px;">Price</th>
                <th style="border: solid 1px black; padding: 10px;">Quantity</th>
                <th></th>
                <th></th>
            </tr>
            <% books.forEach((book) => { %>
                <tr>
                    <td style="border: solid 1px black; padding: 10px;"><%= book.name %></td>
                    <td style="border: solid 1px black; padding: 10px;"><%= "$" + book.price%></td>
                    <td style="border: solid 1px black; padding: 10px;"><%= book.quantity %></td>
                    <td>
                        <button class="book-edit-Btn" data-title="<%- book.name %>"
                                style="background-color: #2062e5; color: white; border-radius: 5px;">
                            Edit
                        </button>
                    </td>
                    <td>
                        <button class="book-delete-Btn" data-title="<%- book.name %>"
                                style="background-color: red; border-radius: 5px;">
                            Delete
                        </button>
                    </td>
                </tr>
            <% }); %>
        </table>

        <form action="/" method="post" class="editBookForm" 
            style="visibility: hidden; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); padding: 20%; background-color: white; border: solid 1px black; border-radius: 10px;">

            <input id="old-book-name" name="oldBookName" style="visibility: hidden;">
            <label for="book-field-selection">Select the field you wish to update:</label>
            <select id="book-field-selection" name="bookFieldSelection" name value="--Field--" style="display: block; margin-bottom: 10px;">
                <option value="--Field--" disabled selected>--Field--</option>
                <option value="Title">Title</option>
                <option value="Price">Price</option>
                <option value="Quantity">Quantity</option>
            </select>
            <label for="book-update">What should this field be updated to?</label>
            <input type="text" id="book-update" name="bookUpdate" style="margin-bottom: 10px;">


            <button type="submit" class="editBookFormSubmit">Update</button>
            <button type="button" class="editBookFormClose" style="position: absolute; top: 2%; right: 2%;">x</button>
        </form>






        <form action="/" method="post" class="deleteBookForm" 
            style="visibility: hidden; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); padding: 20% 5%; background-color: white; border: solid 1px black; border-radius: 10px;">
            <label for="delete-book-warning">Are you sure you would like to delete this genre? </label>
            <input id="delete-book-warning" name="deleteBookInput" style="visibility: hidden;">
            <button type="submit" class="deleteBookFormSubmit">Delete</button>
            <button type="button" class="deleteBookFormClose" style="position: absolute; top: 2%; right: 2%;">x</button>
        </form>

        <script>
            const addBook = document.querySelector(".addBook");
            const addBookForm = document.querySelector(".addBookForm");
            const addBookFormSubmit = document.querySelector(".addBookFormSubmit");
            const addBookFormClose = document.querySelector(".addBookFormClose");
            addBook.addEventListener("click", () => addBookForm.style.visibility = "visible")
            addBookFormClose.addEventListener("click", () => addBookForm.style.visibility = "hidden")
            addBookFormSubmit.addEventListener("click", () => addBookForm.style.visibility = "hidden")

            const editButtons = document.querySelectorAll(".book-edit-Btn");
            const deleteButtons = document.querySelectorAll(".book-delete-Btn");
            const editBookForm = document.querySelector(".editBookForm");
            const deleteBookForm = document.querySelector(".deleteBookForm");
            const editBookFormClose = document.querySelector(".editBookFormClose");
            const deleteBookFormClose = document.querySelector(".deleteBookFormClose");
            const editBookFormSubmit = document.querySelector(".editBookFormSubmit");
            const deleteBookFormSubmit = document.querySelector(".deleteBookFormSubmit");
            const editInput = document.querySelector("#old-book-name")
            const deleteInput = document.querySelector("#delete-book-warning");

            editButtons.forEach(button => {
                button.addEventListener('click', (event) => {
                const title = event.target.dataset.title;
                console.log('Edit clicked for Book:', title);
                editInput.value = title;
                editBookForm.style.visibility = "visible"
                });
            });
            deleteButtons.forEach(button => {
                button.addEventListener('click', (event) => {
                const title = event.target.dataset.title;
                console.log('Delete clicked for book:', title);
                deleteInput.value = title;
                deleteBookForm.style.visibility = "visible"
                });
            });

            editBookFormClose.addEventListener("click", () => editBookForm.style.visibility = "hidden")
            editBookFormSubmit.addEventListener("click", () => editBookForm.style.visibility = "hidden")

            deleteBookFormClose.addEventListener("click", () => deleteBookForm.style.visibility = "hidden")
            deleteBookFormSubmit.addEventListener("click", () => deleteBookForm.style.visibility = "hidden")
        </script>
    </body>
</html>